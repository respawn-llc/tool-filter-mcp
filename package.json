{
  "name": "@respawn-app/tool-filter-mcp",
  "version": "0.5.0",
  "description": "MCP proxy server that filters tools from upstream MCP servers via regex-based deny list",
  "mcpName": "io.github.respawn-llc/tool-filter-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/respawn-llc/tool-filter-mcp.git"
  },
  "homepage": "https://github.com/respawn-llc/tool-filter-mcp#readme",
  "bugs": {
    "url": "https://github.com/respawn-llc/tool-filter-mcp/issues"
  },
  "type": "module",
  "bin": {
    "tool-filter-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc --build",
    "test": "vitest",
    "lint": "biome lint src tests",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "proxy",
    "tool-filter",
    "model-context-protocol"
  ],
  "author": "",
  "license": "MIT",
  "files": [
    "dist/",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "overrides": {
    "minimatch": "11.0.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "safe-regex2": "5.1.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
