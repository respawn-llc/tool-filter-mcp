{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedFunctionParameters": "error",
        "noUnusedVariables": "error"
      },
      "nursery": {
        "noFloatingPromises": "error"
      },
      "style": {
        "useConst": "error"
      },
      "suspicious": {
        "noDoubleEquals": "error",
        "noExplicitAny": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/**/*.ts"],
      "linter": {
        "rules": {
          "nursery": {
            "useExplicitReturnType": "warn"
          },
          "suspicious": {
            "noConsole": {
              "level": "warn",
              "options": {
                "allow": ["error", "warn"]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["tests/**/*.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    }
  ]
}
